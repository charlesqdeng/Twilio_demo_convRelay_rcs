# =============================================================================
# Conversation AI Demo — environment variables
# =============================================================================
# Copy to .env.local and fill in your own values. Do NOT commit .env.local.
#
# The app is a Next.js dashboard with an inline voice agent (GPT-4o) that
# manages service appointments in Airtable and offers reschedules via RCS
# quick-reply. Two provisioning scripts fill in the Twilio-side SIDs for you:
#   npm run provision-twiml   → TwiML App for browser Voice SDK
#   npm run provision-msg     → Messaging Service (attach a sender with add-sender)
# =============================================================================

# --- Twilio account credentials -----------------------------------------------
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Optional: use an API key pair instead of the account auth token. If both are
# set, the API key/secret pair wins.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# --- Messaging (RCS + SMS) ----------------------------------------------------
# Auto-created by `npm run provision-msg`. Its inbound webhook is set to
# ${NEXT_PUBLIC_APP_URL}/api/rcs-inbound so quick-reply taps update Airtable.
TWILIO_MESSAGING_SERVICE_SID=

# Optional. Set to an RCS sender ID (starts with `rcs:`, e.g. `rcs:test_agent`)
# to force RCS-only delivery via that sender, bypassing the Messaging Service.
# The recipient phone number is auto-prefixed with `rcs:` when this is set.
RCS_FROM_NUMBER=

# Twilio Content template SID for the reschedule quick-reply.
# Create/lookup once at http://localhost:3030/voice-agent-setup (or
# GET /api/content-sid?refresh=1). Paste the returned HX... here.
TWILIO_RESCHEDULE_CONTENT_SID=

# --- Voice (browser dial + inline agent) --------------------------------------
# Auto-created by `npm run provision-twiml`.
TWILIO_TWIML_APP_SID=

# Twilio phone number used as callerId on the browser dial (Voice SDK).
TWILIO_PHONE_NUMBER=

# --- Conversational Intelligence (post-call PII transcription) ----------------
# Both auto-created on first recording if unset. The operator SID attaches a
# language operator for enhanced PII extraction; leave blank to skip.
TWILIO_INTELLIGENCE_SERVICE_SID=
TWILIO_INTELLIGENCE_OPERATOR_SID=

# --- OpenAI (inline voice agent) ----------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the default (gpt-4o)
OPENAI_MODEL=

# --- Airtable (appointment records) -------------------------------------------
# https://airtable.com/create/tokens — needs read+write on the base below.
AIRTABLE_API_KEY=patxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx
AIRTABLE_APPOINTMENTS_TABLE=Appointments

# --- App configuration --------------------------------------------------------
# Public URL used by webhooks (ngrok or production domain).
NEXT_PUBLIC_APP_URL=https://your-subdomain.ngrok.io

# --- Branding -------------------------------------------------------------------
# Customer name shown throughout the portal (header, page titles, Overview).
# Defaults to "Betwext". Restart `npm run dev` after changing.
NEXT_PUBLIC_CUSTOMER_NAME=Betwext
# Optional: 1–3 letters for the header logo badge. Derived from the name if unset.
NEXT_PUBLIC_CUSTOMER_INITIALS=
